# 用途：标识运行环境；获取：按部署环境填写 development 或 production；必填：是。
APP_ENV=development
# 用途：材料入口模式，synthetic_only仅允许无真实信息的自制样本，real_documents接收真实资料并强制检查全部启用服务政策；获取：由部署者在核实供应商政策后切换；必填：否，默认synthetic_only，不能用于宣称正式可用。
MATERIAL_MODE=synthetic_only
# 用途：已发布的非秘密服务政策JSON，键为storage/ocr/chat/extract/translate/vision，每项含display_name、region、retention_days、deletion_supported、verified、evidence_reference；获取：逐服务核对合同/隐私政策/删除接口并填写实际依据，不能从模型名或地址猜测；必填：真实资料模式是，缺项、未核实、超过30天或无主动删除能力拒绝上传。示例结构见D5实施记录，不填密钥。
SERVICE_POLICIES={}
# 用途：专业审核后的窄货描/HS风险包JSON数组，新Run冻结版本和来源，不影响历史Run；获取：审核人提供版本、审核记录、权威HTTPS来源SHA256、日期、目的国/货类、完整货描词组及六位码白名单；必填：否，未填继续标未覆盖；不能用自动生成记录伪装专业审核。
REVIEWED_RULE_PUBLICATIONS=[]
# 用途：审核包原文与审核记录的独立证据目录，只在服务端读取，不发送给模型；获取：由部署者保存官方原文及实际专业审核JSON记录；必填：启用approved规则包时是。空值、缺文件或哈希不一致时不发布规则。审核记录字段见专项实施台账X5。
RULE_EVIDENCE_DIRECTORY=
# 用途：允许作为已审核包来源的官方主机名JSON列表；获取：由管理员逐一核对权威官网后填写完整hostname，不接受泛域名或第三方代理；必填：启用approved规则包时是，默认空列表拒绝发布。示例["www.customs.gov.cn"]仅为格式示例，不代表本项目已核验此类规则。
RULE_OFFICIAL_DOMAINS=[]
# 用途：开发前端转发 /api 到本地 API；获取：填写实际 FastAPI 地址；必填：本地前后端联调时是。
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# 用途：首页「联系我们」页显示的团队或单位名称；获取：由部署方填写对外公开的团队名；必填：否，未填则不显示该行。注意：VITE_ 开头的变量会打包进浏览器代码，只能填可公开的信息，修改后需重新构建或重启前端。
VITE_CONTACT_TEAM=
# 用途：「联系我们」页显示的联系邮箱，点击可直接发邮件；获取：填写部署方用于账号申请和问题反馈的公开邮箱；必填：否，三项都未填时页面提示联系部署方或管理员。注意事项同上。
VITE_CONTACT_EMAIL=
# 用途：「联系我们」页显示的联系电话，手机端可点击拨号；获取：填写部署方愿意公开的服务电话；必填：否，未填则不显示该行。注意事项同上。
VITE_CONTACT_PHONE=
# 用途：浏览器实际访问本系统的来源，用于 Cookie、CSRF 来源校验和对象存储桶 CORS；获取：填写部署后页面地址（协议+主机+端口，不带路径），本地开发如 http://127.0.0.1:5173；必填：启用登录或浏览器直传时是。
APP_PUBLIC_ORIGIN=
# 用途：业务数据库连接，供领域表和迁移使用；获取：从本项目 PostgreSQL 实例取得 asyncpg 连接串；必填：实现持久化后是。
DATABASE_URL=
# 用途：LangGraph PostgreSQL 检查点连接；获取：从同一 PostgreSQL 实例取得 psycopg 兼容连接串；必填：启用持久图时是。
CHECKPOINT_DATABASE_URL=
# 用途：Celery 队列和短期通知连接；获取：从本项目 Redis 实例取得连接串；必填：启用后台任务时是。
REDIS_URL=
# 用途：对象存储 API 地址；获取：从 MinIO 或经批准的 S3 兼容服务取得；必填：启用文件上传时是。
S3_ENDPOINT=
# 用途：签名直传 URL 中浏览器可达的对象存储地址，须为 HTTPS 或经同源反向代理；获取：按 MinIO/S3 的对外域名或反向代理地址填写，不能填容器内部的 minio:9000；必填：启用浏览器直传时是。
S3_PUBLIC_ENDPOINT=
# 用途：生成签名 URL 使用的区域，须与对象存储服务配置一致；获取：MinIO 默认 us-east-1，其他 S3 兼容服务见其控制台；必填：启用文件上传时是。
S3_REGION=us-east-1
# 用途：原件与产物使用的对象存储桶；获取：在对象存储中创建后填写桶名；必填：启用文件上传时是。
S3_BUCKET=
# 用途：服务端对象存储访问账号；获取：从对象存储管理员创建的最小权限账号取得；必填：启用文件上传时是。
S3_ACCESS_KEY=
# 用途：服务端对象存储访问密钥；获取：与 S3_ACCESS_KEY 同时由对象存储管理员发放；必填：启用文件上传时是。
S3_SECRET_KEY=
# 用途：服务端会话签名密钥；获取：部署时用安全随机源生成并保存在本地 .env；必填：启用登录时是。
SESSION_SIGNING_KEY=
# 用途：AES-GCM 加密个人 MCP 凭证；获取：在项目 uv 环境用 secrets.token_bytes(32) 生成32字节并以URL-safe Base64编码；生产由密钥服务保管；必填：保存个人 MCP 凭证时是，不填禁止接收密钥。
MCP_CREDENTIAL_MASTER_KEY=
# 用途：MinerU 精准解析 v4 API 根地址；获取：官方为 https://mineru.net/api/v4，本地代理须实现相同协议；必填：使用 MinerU 云解析时是。
MINERU_BASE_URL=
# 用途：MinerU Token（也兼容 MINERU_API_TOKEN）；获取：https://mineru.net/apiManage 创建，填纯Token即可；必填：使用精准解析时是。
MINERU_API_KEY=
# 用途：精准解析模型，vlm 为官网推荐，pipeline 为传统解析；获取：官方API文档model_version；可选，默认vlm，仅影响新提交的OCR步骤，已提交任务不换模型。
MINERU_MODEL_VERSION=vlm
# 用途：OCR语言包，与翻译目标语言独立；获取：官方API文档language表，ch为中英文，en纯英文，latin拉丁语系，其他按表选；可选，默认ch，不使用auto。
MINERU_LANGUAGE=ch

# 用途：对话模型 API 根地址；获取：从用户选定的非百炼模型服务文档取得；必填：启用对话时是。
CHAT_MODEL_BASE_URL=
# 用途：对话模型 API Key；获取：由用户在该服务控制台创建后填入本地 .env；必填：启用对话时是。
CHAT_MODEL_API_KEY=
# 用途：对话模型 ID；获取：从该服务模型列表选择并完成能力测试；必填：启用对话时是。
CHAT_MODEL_NAME=
# 用途：对话接口协议适配器名称；获取：首版已确定使用 OpenAI 兼容 Chat Completions，实际端点仍需实测；必填：启用对话时是。
CHAT_MODEL_PROTOCOL=openai_chat_completions
# 用途：对话请求超时秒数；获取：按模型延迟测试结果调整；必填：启用对话时是。
CHAT_MODEL_TIMEOUT_SECONDS=45
# 用途：对话单次最大输出 token；获取：按模型窗口与样本问答调整；必填：启用对话时是。
CHAT_MODEL_MAX_OUTPUT_TOKENS=4000
# 用途：对话模型并发上限；获取：按服务额度和压测结果调整；必填：启用对话时是。
CHAT_MODEL_MAX_CONCURRENCY=4
# 用途：对话生成温度；获取：按模型支持范围和领域问答样本调整；必填：启用对话且接口支持时是。
CHAT_MODEL_TEMPERATURE=0.2
# 用途：对话模型是否启用深度思考；获取：先在该服务官方接口文档核实 enable_thinking，再通过实际请求和推理用量验证。
# 必填：否。不支持或未测试时留空，不发送此参数；支持时 true 开启、false 关闭。常规抽取／翻译可关闭以减少首字等待，值随任务冻结，旧任务不因改.env而改变。
CHAT_MODEL_ENABLE_THINKING=

# 用途：字段抽取模型 API 根地址；获取：从用户选定的非百炼模型服务文档取得；必填：启用复杂字段抽取时是。
EXTRACT_MODEL_BASE_URL=
# 用途：字段抽取模型 API Key；获取：由用户在该服务控制台创建后填入本地 .env；必填：启用复杂字段抽取时是。
EXTRACT_MODEL_API_KEY=
# 用途：字段抽取模型 ID；获取：从该服务模型列表选择并完成结构化输出测试；必填：启用复杂字段抽取时是。
EXTRACT_MODEL_NAME=
# 用途：字段抽取接口协议适配器名称；获取：首版已确定使用 OpenAI 兼容 Chat Completions，结构化输出能力仍需实测；必填：启用复杂字段抽取时是。
EXTRACT_MODEL_PROTOCOL=openai_chat_completions
# 用途：字段抽取请求超时秒数；获取：按长表样本延迟调整；必填：启用复杂字段抽取时是。
EXTRACT_MODEL_TIMEOUT_SECONDS=60
# 用途：字段抽取单次最大输出 token；获取：按字段 schema 与行数样本调整；必填：启用复杂字段抽取时是。
EXTRACT_MODEL_MAX_OUTPUT_TOKENS=6000
# 用途：字段抽取模型并发上限；获取：按服务额度和费用预算调整；必填：启用复杂字段抽取时是。
EXTRACT_MODEL_MAX_CONCURRENCY=2
# 用途：字段抽取生成温度；获取：按该接口支持范围与准确率样本调整；必填：接口支持时是。
EXTRACT_MODEL_TEMPERATURE=0
# 用途：字段抽取模型是否启用深度思考；获取：先在该服务官方接口文档核实 enable_thinking，再通过实际请求和推理用量验证。
# 必填：否。不支持或未测试时留空，不发送此参数；支持时 true 开启、false 关闭。常规抽取／翻译可关闭以减少首字等待，值随任务冻结，旧任务不因改.env而改变。
EXTRACT_MODEL_ENABLE_THINKING=

# 用途：翻译模型 API 根地址；获取：从用户选定的非百炼模型服务文档取得；必填：启用翻译工作流时是。
TRANSLATE_MODEL_BASE_URL=
# 用途：翻译模型 API Key；获取：由用户在该服务控制台创建后填入本地 .env；必填：启用翻译工作流时是。
TRANSLATE_MODEL_API_KEY=
# 用途：翻译模型 ID；获取：从该服务模型列表选择并完成术语与标识保护测试；必填：启用翻译工作流时是。
TRANSLATE_MODEL_NAME=
# 用途：翻译接口协议适配器名称；获取：首版已确定使用 OpenAI 兼容 Chat Completions，实际端点仍需实测；必填：启用翻译工作流时是。
TRANSLATE_MODEL_PROTOCOL=openai_chat_completions
# 用途：翻译请求超时秒数；获取：按片段批量翻译延迟调整；必填：启用翻译工作流时是。
TRANSLATE_MODEL_TIMEOUT_SECONDS=60
# 用途：翻译单次最大输出 token；获取：按源译片段长度与上下文窗口调整；必填：启用翻译工作流时是。
TRANSLATE_MODEL_MAX_OUTPUT_TOKENS=6000
# 用途：翻译模型并发上限；获取：按服务额度和费用预算调整；必填：启用翻译工作流时是。
TRANSLATE_MODEL_MAX_CONCURRENCY=2
# 用途：翻译生成温度；获取：按该接口支持范围与术语一致性样本调整；必填：接口支持时是。
TRANSLATE_MODEL_TEMPERATURE=0
# 用途：翻译模型是否启用深度思考；获取：先在该服务官方接口文档核实 enable_thinking，再通过实际请求和推理用量验证。
# 必填：否。不支持或未测试时留空，不发送此参数；支持时 true 开启、false 关闭。常规抽取／翻译可关闭以减少首字等待，值随任务冻结，旧任务不因改.env而改变。
TRANSLATE_MODEL_ENABLE_THINKING=

# 用途：局部视觉复读模型 API 根地址；获取：从用户选定的非百炼视觉模型服务文档取得；必填：启用视觉复读时是，否则留空。
VISION_MODEL_BASE_URL=
# 用途：局部视觉复读模型 API Key；获取：由用户在该服务控制台创建后填入本地 .env；必填：启用视觉复读时是，否则留空。
VISION_MODEL_API_KEY=
# 用途：视觉模型 ID；获取：从该服务模型列表选择并验证图片输入；必填：启用视觉复读时是，否则留空。
VISION_MODEL_NAME=
# 用途：视觉接口协议适配器名称；获取：首版已确定使用 OpenAI 兼容 Chat Completions，图片输入能力仍需实测；必填：启用视觉复读时是，未启用时默认值不生效。
VISION_MODEL_PROTOCOL=openai_chat_completions
# 用途：视觉请求超时秒数；获取：按局部图片样本延迟调整；必填：启用视觉复读时是。
VISION_MODEL_TIMEOUT_SECONDS=60
# 用途：视觉单次最大输出 token；获取：按区域复读结果长度调整；必填：启用视觉复读时是。
VISION_MODEL_MAX_OUTPUT_TOKENS=2000
# 用途：视觉模型并发上限；获取：按服务额度和费用预算调整；必填：启用视觉复读时是。
VISION_MODEL_MAX_CONCURRENCY=1
# 用途：视觉生成温度；获取：按该接口支持范围与复读准确率调整；必填：接口支持时是。
VISION_MODEL_TEMPERATURE=0
# 用途：视觉复读模型是否启用深度思考；获取：先在该服务官方接口文档核实 enable_thinking，再通过实际请求和推理用量验证。
# 必填：否。不支持或未测试时留空，不发送此参数；支持时 true 开启、false 关闭。常规抽取／翻译可关闭以减少首字等待，值随任务冻结，旧任务不因改.env而改变。
VISION_MODEL_ENABLE_THINKING=

# 用途：单次对话模型输入 token 上限；获取：按所选模型窗口与评测结果调整；必填：启用对话时是。
CHAT_INPUT_TOKEN_BUDGET=24000
# 用途：每个对话Turn内摘要、意图、通用知识及重试/修复共用的人民币模型费用上限；获取：管理员按允许的每轮预算填写正数元；必填：否，留空不限人民币费用但仍记录费用与调用/token预算。设置时CHAT须有核实报价与完整usage，历史费用未知会阻止本轮下一次请求；新Turn冻结此值，旧Turn不追读当前配置。Run费用上限不覆盖对话。
CHAT_MAX_MODEL_COST_CNY=
# 用途：同会话滚动摘要 token 上限；获取：按对话评测调整；必填：启用摘要时是。
SESSION_SUMMARY_TOKEN_LIMIT=2000
# 用途：一轮检索片段 token 上限；获取：按来源问答评测调整；必填：启用文件问答时是。
RETRIEVED_CONTEXT_TOKEN_LIMIT=6000
# 用途：一轮最多装载的来源片段数；获取：按来源问答评测调整；必填：启用文件问答时是。
RETRIEVED_SEGMENT_COUNT_LIMIT=8
# 用途：模型回答和工具协议预留 token；获取：按所选模型窗口调整；必填：启用对话时是。
RESPONSE_TOKEN_RESERVE=4000
# 用途：单轮最多规划次数；获取：按复杂问答评测与延迟预算调整；必填：启用对话时是。
CHAT_MAX_PLAN_ROUNDS=2
# 用途：单轮最多逻辑工具调用数；获取：按复杂问答评测与费用预算调整；必填：启用对话时是。
CHAT_MAX_TOOL_CALLS=4
# 用途：单文件允许上传的最大字节数；获取：按部署存储与样本文件规模调整；必填：启用上传时是。
UPLOAD_MAX_BYTES=52428800
# 用途：单文件允许的最大页数；获取：按解析服务限制和费用预算调整；必填：启用上传时是。
UPLOAD_MAX_PAGES=100
# 用途：单 Run 最多参与的已验收源文件数；获取：按 D0 获授权样本和 Worker 执行时限实测调整，示例值只供本地起步；必填：启用后台单证处理时是。
RUN_MAX_FILES=5
# 用途：单 Run 参与原件的字节总量上限；获取：按 D0 样本、解析成本和对象存储吞吐实测调整，单位字节；必填：启用后台单证处理时是。
RUN_MAX_TOTAL_BYTES=104857600
# 用途：单 Run 可计页材料的累计页数上限；获取：按 D0 解析服务时延与费用实测调整，DOCX 等不可直接计页的材料另用字节/结构复杂度门禁；必填：启用后台单证处理时是。
RUN_MAX_TOTAL_PAGES=100
# 用途：单次 Celery 图执行的软时限秒数；获取：按 D0 最慢可接受样本和供应商超时实测调整，软时限应先触发安全退出/待核查；必填：启用后台单证处理时是。
WORKFLOW_TASK_SOFT_LIMIT_SECONDS=900
# 用途：单次 Celery 图执行的硬时限秒数；获取：比软时限留出持久化供应商受理状态和释放资源的窗口；必填：启用后台单证处理时是。
WORKFLOW_TASK_HARD_LIMIT_SECONDS=1020
# 用途：Redis/Celery 重新投递未确认任务前的可见性超时秒数；获取：大于硬时限并按队列配置实测，重复投递仍由租约与指纹拦截；必填：使用 Redis broker 时是。
CELERY_VISIBILITY_TIMEOUT_SECONDS=1200
# 用途：单 Run 模型人民币费用上限（不含OCR）；获取：部署者按预算填写，必须先在MODEL_PRICES配置参与角色已核实的人民币全包报价，否则不受理；必填：否，暂无可信供应商报价时留空。每次HTTP尝试按冻结价格预留，完整usage实际累计；费用未知或超额后停止后续外发，不保证供应商错误usage或窗口超收。
RUN_MAX_MODEL_COST_CNY=
# 用途：前端在 SSE 不可用时的轮询间隔秒数；获取：按部署负载调整；必填：启用降级轮询时是。
EVENT_POLL_SECONDS=5
# 用途：后台扫描未投递与超时步骤的间隔秒数；获取：按恢复时延要求调整；必填：启用后台任务时是。
RECOVERY_SCAN_SECONDS=30
# 用途：单票最后一次实质性业务变更后的保留天数；获取：当前产品政策固定为 30，变更前须同步需求、告知与清理验收；必填：启用真实单票存储时是。
CASE_RETENTION_DAYS=30
# 用途：扫描到期单票及失败删除作业的间隔秒数；获取：按部署任务调度负载调整，读取接口仍独立执行到期门禁；必填：启用自动到期清理时是。
CASE_PURGE_SCAN_SECONDS=3600
# 用途：签名直传 PUT 地址的有效期秒数；获取：须短于整票删除的清理上限（24 小时），并留出浏览器上传所需时间；必填：启用浏览器直传时是。
UPLOAD_SIGNED_URL_TTL_SECONDS=900
# 用途：允许新增 MCP 连接的主机白名单，逗号分隔；获取：由部署方按已评估的远端服务填写，留空表示不允许新增任何外部连接；必填：启用 MCP 连接时是。
MCP_ALLOWED_HOSTS=
# 用途：维护者发布仅公开资料的MCP调用范围，JSON数组每项必须含endpoint/tool_id/schema_hash/parameters；获取：先批准HTTPS公网主机并实测tools/list，按服务端规范化JSON计算schema SHA256，再人工核实每个有限字符串或布尔值仅代表公开资料。参数键必须与schema全部properties一致，不允许自由文本、regex、对象/数组/数值；必填：自建服务要可调用时是。留空仅保留已验DeepWiki的langchain-ai/langgraph，同端点工具/hash项显式替代默认参数列表；无效配置禁用MCP目录与调用，不回退许可。示例见D6文档，不能填写单票/客户/原文内容，不替代本人逐工具授权。
MCP_PUBLIC_TOOL_REGISTRY_JSON=
# 用途：MCP 握手、工具发现与调用的单次超时秒数；获取：按远端服务实测响应调整；必填：启用 MCP 连接时是。
MCP_TIMEOUT_SECONDS=20
# 用途：单次 MCP 响应允许的最大字节数；获取：按远端工具实际返回规模设置，防止超大响应拖垮 Worker；必填：启用 MCP 连接时是。
MCP_MAX_RESPONSE_BYTES=262144
# 用途：解析适配器实现；获取：填 mineru 使用真实 MinerU 服务，填 deterministic_fake 使用本地确定性假解析以便在没有 Key 时联调工程链路；必填：是。
PARSER_ADAPTER=deterministic_fake
# 用途：模型适配器实现；获取：填 openai_compatible 使用真实模型服务，填 deterministic_fake 使用本地确定性假模型以便在没有 Key 时联调工程链路；必填：是。
MODEL_ADAPTER=deterministic_fake

# 用途：每个Run所有模型步骤累计HTTP尝试次数上限，跨Epoch累计，安全重试和格式修复均计数；获取：由部署者按调用预算和样本规模设置，无需供应商申请；必填：否，短单证默认120。
# 约100页长文可配置600，同时评估下方token上限。额度耗尽时下一请求不会发出；调整.env并重启相关服务后可重试原Run，复用已完成结果，旧调用不会清零。
RUN_MAX_MODEL_CALLS=120
# 用途：每个Run跨Epoch累计模型token上限，缺usage时使用保守预留，超限停止外发；获取：按服务token配额和样本规模设置；必填：否，短单证默认1000000。
# 约100页长文可配置4000000；须与请求次数及已有用量一起评估，不代表已实测所有100页材料都能完成。部署额度调整可安全续跑原Run，不能通过重试清空账本或绕过人民币限额。
RUN_MAX_MODEL_TOKENS=1000000
# 用途：每个Run已分配的OCR供应商任务总上限；获取：由部署者按费用预算与嵌图数设定，无需供应商申请；必填：否，默认30，跨Epoch累计，未知任务仍计数。
RUN_MAX_OCR_TASKS=30
# 用途：同一OCR任务可读取状态的次数上限；获取：按供应商队列时间和30秒续查间隔设定；必填：否，默认120，超过后保留任务ID转运营核查，禁止重新上传。
RUN_MAX_OCR_POLLS=120
# 用途：单份DOCX允许的内嵌图片数量上限；获取：按本机解包能力和OCR预算调整；必填：否，默认8，超限明确拒绝，不跳过后宣称完整。
DOCX_MAX_EMBEDDED_IMAGES=8
# 用途：单幅DOCX嵌图字节上限；获取：按供应商输入限制和内存预算设置，单位字节；必填：否，默认10MiB。
DOCX_MAX_EMBEDDED_IMAGE_BYTES=10485760
# 用途：单份DOCX全部嵌图解包字节上限；获取：按项目内存与OCR预算设置，单位字节；必填：否，默认30MiB，DOCX ZIP还受既有200MiB总解包门禁。
DOCX_MAX_EMBEDDED_TOTAL_BYTES=31457280

# 用途：独立于数据库备份的加密删除账本目录；获取：部署时创建项目Git目录之外的持久目录，设置仅服务账号可读写；必填：主动删除、到期清理和灾备恢复时是。
DELETE_LEDGER_PATH=
# 用途：独立删除账本专用AES-GCM密钥；获取：项目uv环境中使用secrets.token_bytes(32)并URL-safe Base64编码，备份在独立密钥服务，不能复用会话密钥；必填：启用删除账本时是。
DELETE_LEDGER_KEY=
# 用途：撤权后等待在途对象写入结束的秒数，随后重新扫描并清理全部版本；获取：按对象存储请求超时设置；必填：否，默认60秒。
PURGE_INFLIGHT_GRACE_SECONDS=60

# 用途：每个模型角色下同一租户的跨进程外发并发上限，与角色总上限同时执行；获取：部署者按租户隔离和吞吐预算设置；必填：否，默认1。
MODEL_TENANT_MAX_CONCURRENCY=1
# 用途：供应商故障窗口内触发新请求冷却的失败次数；获取：部署者按实际服务稳定性调整；必填：否，默认4；模型传输中断按下列有限重试策略执行，其他未知受理保留核查。
MODEL_FAILURE_THRESHOLD=4
# 可选：工作流抽取/翻译内部使用OpenAI SSE接收长JSON，完整接收后才校验落库。
# 供应商必须支持Chat Completions stream=true；无需另领Key。默认false，实测兼容后设true。
# 对话逐字预览使用独立流式通道；此项不把原始工作流JSON展示给用户。
MODEL_WORKFLOW_STREAM=false
# 用途：模型超时、断流及暂时不可用后自动重发失败批次；可能有重复供应商费用，账本逐次记录；获取：部署者按业务偏好设置；必填：否，默认true。OCR未知提交和外部写工具不受此开关影响。
MODEL_RETRY_INTERRUPTED=true
# 用途：一次模型逻辑调用的实际请求总上限，包含传输重试和输出修复；获取：按服务稳定性和调用预算设置1至5；必填：否，默认3。
MODEL_MAX_ATTEMPTS=3
# 用途：一组模型尝试的总时限秒数，含排队和退避；单次请求仍受各角色TIMEOUT_SECONDS约束；获取：须小于Worker软时限并预留45秒提交时间；必填：否，默认600。
MODEL_RETRY_TOTAL_TIMEOUT_SECONDS=600
# 用途：供应商连续失败计数窗口，单位秒；获取：部署者按限流周期调整；必填：否，默认60，成功响应清除计数。
MODEL_FAILURE_WINDOW_SECONDS=60
# 用途：达到失败阈值后暂缓新外发的秒数；获取：部署者按供应商恢复时间调整；必填：否，默认30，冷却后仍受并发上限约束。
MODEL_COOLDOWN_SECONDS=30

# 各角色模型上下文总窗口（输入＋输出），必需确认；从模型服务官方规格获取，未配置按保守16000处理。
# 更换模型时同时修改；请求会预留实际输出上限并在网关再次检查，不能填宣传值而未经接口验证。
CHAT_MODEL_CONTEXT_WINDOW_TOKENS=16000
EXTRACT_MODEL_CONTEXT_WINDOW_TOKENS=16000
TRANSLATE_MODEL_CONTEXT_WINDOW_TOKENS=16000
VISION_MODEL_CONTEXT_WINDOW_TOKENS=16000

# 用途：各模型角色的已核实人民币全包 token 报价（JSON，非秘密）；获取：向实际中转/模型供应商索取当前含税账单价及书面计费说明，不能套用其他官方直连服务价格；必填：否，设置 RUN_MAX_MODEL_COST_CNY 时参与角色必须有匹配报价。
# 键为 chat/extract/translate/vision。每项 version=供应商价目版本，evidence_reference=可复核价目URL或内部确认记录ID，verified=true仅在实际人工核实后填写。
# base_url/model_name/protocol 必须与对应角色实际配置一致；currency仅支持CNY；billing_basis必须为all_inclusive_prompt_completion_tokens，确认推理token已包含在completion且无缓存/图片/请求等额外费用或阶梯计价。
# input_cny_per_million/output_cny_per_million 由供应商按每百万输入/输出token的人民币全包价格填写，可为0但必须有明确免费依据。报价会随模型绑定冻结；新价格不得回填旧Run。未配置的调用费用保持未知；当前人民币上限仅约束模型费用，OCR和总费用未定价。
MODEL_PRICES={}

# 用途：OCR已核实人民币全包单价（JSON数组，非秘密）；获取：向实际MinerU服务供应商索取含税报价、按页/任务口径与处理模式说明，官方未给报价时保持[]；必填：否，仅用于有依据的估算，不启用总费用上限。
# 每项version为价目版本，evidence_reference为可复核供应商价目URL/确认记录ID；verified=true仅在人工核实后填写。base_url与MINERU_BASE_URL一致，protocol固定mineru_v4_batch/1，currency固定CNY。
# model_version填写vlm/pipeline，language与MINERU_LANGUAGE一致，enable_formula=false、enable_table=true、is_ocr=true与当前实际选项一致；不同模式分别报价，不能用pipeline价推断vlm价。同一模式不能重复配置，否则估算未知。
# billing_basis填写all_inclusive_per_page或all_inclusive_per_task；unit_cny为每页/每任务的全包人民币价，0必须有明确免费依据。只支持无额外模式/公式/表格/请求等费用的全包口径，阶梯、额度折扣或多项组合计费需供应商确认后另行适配。
# 报价与OCR选项启动时冻结，新价格不回填旧任务；PDF预估按全页、图片每张一页、DOCX按嵌图上限，解析后按实际OCR页缩小。当前MinerU回包没有可核验实际fee，已受理任务实际OCR费用仍未知，估算不可当账单。
OCR_PRICES=[]

# 对话使用供应商真实增量输出；可选，默认true，不需要单独Key，复用CHAT_MODEL配置。
CHAT_STREAM_ENABLED=true
# 单次供应商SSE总字节上限，可选；含逐token事件协议开销；限制异常响应/推理数据，默认2097152（2MB）。
CHAT_STREAM_MAX_BYTES=2097152
# 单个供应商SSE事件字节上限，可选；从部署压测调整，无需外部凭据，默认65536。
CHAT_STREAM_EVENT_MAX_BYTES=65536
# 一次待核验正文最大字符数，可选，默认50000。
CHAT_STREAM_MAX_CHARS=50000
# 每个持久预览事件最多字符数，可选，默认256，降低DB和页面开销。
CHAT_STREAM_EVENT_CHARS=256
# 活动对话SSE轮询间隔秒数，可选，默认0.2；不改变上传/Run轮询。
CHAT_STREAM_POLL_SECONDS=0.2
# 未闭合引用/敏感前缀缓冲上限，可选，默认2048；异常超限停止预览。
CHAT_STREAM_PENDING_CHARS=2048

# 普通用户自助注册；可选，默认false。部署管理员按是否对外开放设置，无需外部申请。
REGISTRATION_ENABLED=false
# 注册是否需要邮箱验证码；可选，默认true。仅管理员明确设false才能切换为用户名+邮箱+密码注册。
REGISTRATION_REQUIRE_EMAIL_CODE=true
# 发信提供方；验证码注册必填smtp，复用已有邮箱服务，不共用其他站点用户库。
MAIL_PROVIDER=smtp
# 发件地址；验证码注册必填，向单位邮箱管理员获取，通常与SMTP_USERNAME一致。
MAIL_FROM=
# 回复地址；可选，向单位邮箱管理员获取，可留空。
MAIL_REPLY_TO=
# SMTP服务器；验证码注册必填，从邮箱提供商SMTP设置获取，例如腾讯企业邮箱smtp.exmail.qq.com。
SMTP_HOST=
# SMTP端口；可选，默认465使用SSL，其他端口要求STARTTLS，由邮箱服务商提供。
SMTP_PORT=465
# SMTP登录账号；验证码注册必填，从邮箱管理员获取，通常为完整邮箱地址。
SMTP_USERNAME=
# SMTP密码或专用授权码；验证码注册必填，在邮箱安全设置生成或向管理员获取，勿提交真实值。
SMTP_PASSWORD=
# SMTP超时秒数；可选，默认20，按服务器网络情况设置，无需外部凭据。
SMTP_TIMEOUT_SECONDS=20
