# 备份加密AES-256密钥，必填，部署方从KMS/秘密管理器提供32字节URL-safe Base64；禁止与删除账本共用。
BACKUP_ENCRYPTION_KEY=
# 恢复只允许演练库名logistics_restore_开头，必填于恢复；预建隔离PostgreSQL并提供owner连接，不能填写运行库。
RESTORE_DATABASE_URL=
# 检查点原为独立库时必填独立演练库；同主库可省略。
RESTORE_CHECKPOINT_DATABASE_URL=
# 演练桶名必须logistics-restore-开头，必填于恢复；预建私有且开启版本控制，不能填写运行桶。
RESTORE_S3_BUCKET=
# 选填：本机没有pg_dump/pg_restore时复用已运行的PostgreSQL容器客户端；必须是当前连接同一实例，不能填写陌生容器。获取：docker ps中的已存在容器名，生产留空用容器内工具。
BACKUP_POSTGRES_CONTAINER=
