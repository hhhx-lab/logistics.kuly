# Compose镜像版本，发布后应填内部仓库不可变digest；必填，部署流水线构建/签发。
BACKEND_IMAGE=logistics-agent-backend:0.1.0
FRONTEND_IMAGE=logistics-agent-web:0.1.0
# 项目根目录绝对路径；必填，Compose多文件的相对路径均以首个文件为基准，此参数保证单独/合并编排构建相同源码。
PROJECT_DIRECTORY=/srv/logistics-agent
# 运行时env与迁移身份env的绝对路径；必填，按根.env.example填写。后者DATABASE_URL仅迁移时用owner，禁止给API。
RUNTIME_ENV_FILE=/secure/logistics/runtime.env
MIGRATION_ENV_FILE=/secure/logistics/migration.env
# Worker/monitor独立身份env；必填，需租户目录只读、SET ROLE logistics_worker与检查点必要权限，不使用迁移owner。API当前内置Outbox/恢复循环也需受限协调权限，生产签收须核实际授权。
WORKER_ENV_FILE=/secure/logistics/worker.env
# 独立于主库/数据库备份的删除账本挂载目录；必填，部署侧先建0700且uid10001可写。
DELETE_LEDGER_DIRECTORY=/secure/logistics/deletion-ledger
# 本机Web绑定端口；选填。对外入口由独立TLS反向代理配置，不能公网裸HTTP放真实材料。
WEB_PORT=8080
# 删除账本密文的另一故障域挂载路径，必填于compose.recovery.yml；不能与原目录相同，部署方提供。
DELETE_LEDGER_MIRROR_DIRECTORY=/independent/logistics/ledger-mirror
# 加密备份目录，必填于恢复编排；部署方建私有独立卷/挂载，业务账号无访问权。
BACKUP_DIRECTORY=/independent/logistics/backups
# 独立只读备份角色运行env，必填于backup profile；按根示例配置PG备份身份与只读S3身份。
BACKUP_RUNTIME_ENV_FILE=/secure/logistics/backup-runtime.env
# 备份密钥env，必填于backup profile；按ops/backup.env.example由KMS/秘密管理器提供。
BACKUP_ENV_FILE=/secure/logistics/backup.env
