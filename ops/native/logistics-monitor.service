[Unit]
Description=Logistics document agent operational monitor
After=logistics-api.service

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/logistics-agent/app/src/backend
EnvironmentFile=/opt/logistics-agent/config/server.env
EnvironmentFile=/opt/logistics-agent/config/worker.env
ExecStart=/opt/logistics-agent/app/src/backend/.venv/bin/python /opt/logistics-agent/app/ops/runtime.py monitor
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/logistics-agent

[Install]
WantedBy=multi-user.target
