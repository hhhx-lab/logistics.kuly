[Unit]
Description=Logistics document agent private S3 storage
After=network.target

[Service]
User=ubuntu
Group=ubuntu
EnvironmentFile=/opt/logistics-agent/config/storage.env
WorkingDirectory=/var/lib/logistics-agent
ExecStart=/opt/logistics-agent/bin/rustfs server /var/lib/logistics-agent/objects --address 127.0.0.1:9000
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/logistics-agent

[Install]
WantedBy=multi-user.target
