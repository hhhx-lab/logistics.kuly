# 用途：运行模式控制 Secure Cookie；获取：本部署固定 production；必填：是。
APP_ENV=production
# 用途：浏览器来源及 CSRF 校验；获取：DNS 和证书完成后的 HTTPS 子域名；必填：是。
APP_PUBLIC_ORIGIN=https://logistics.kuly.com.cn
# 用途：独立任务队列；获取：本机 logistics-redis.service 的 loopback 端口；必填：是。
REDIS_URL=redis://127.0.0.1:6380/0
# 用途：服务端私有 S3 连接；获取：本机 S3 服务监听地址；必填：是。
S3_ENDPOINT=http://127.0.0.1:9000
# 用途：生成同源签名 PUT 地址；获取：Nginx 子域名的限桶上传入口；必填：是。
S3_PUBLIC_ENDPOINT=https://logistics.kuly.com.cn
# 用途：S3 身份；获取：从服务器私有配置取得随机生成账号；必填：是，不使用本地 test。
S3_ACCESS_KEY=
# 用途：S3 身份密钥；获取：从服务器私有配置取得随机生成密钥；必填：是，禁止提交。
S3_SECRET_KEY=
# 用途：撤权和删除账本路径；获取：部署侧建立权限 0700 的独立目录；必填：是。
DELETE_LEDGER_PATH=/var/lib/logistics-agent/deletion-ledger
# 用途：运维进程及时输出日志；获取：固定 1；必填：否。
PYTHONUNBUFFERED=1
# DATABASE_URL 和 CHECKPOINT_DATABASE_URL 分别放到 api.env、worker.env、migration.env。
# 用途：业务库和检查点连接；获取：部署时创建的非超级用户/无 BYPASSRLS 独立身份；必填：是。
# 迁移身份仅由 bootstrap.py 使用，禁止给 API 和 Worker 使用迁移 owner。
DATABASE_URL=
CHECKPOINT_DATABASE_URL=
