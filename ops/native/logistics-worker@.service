[Unit]
Description=Logistics document agent %i worker
After=network-online.target postgresql.service logistics-redis.service logistics-storage.service
Requires=logistics-redis.service logistics-storage.service

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/logistics-agent/app/src/backend
EnvironmentFile=/opt/logistics-agent/config/server.env
EnvironmentFile=/opt/logistics-agent/config/worker.env
ExecStart=/opt/logistics-agent/app/src/backend/.venv/bin/python -m celery -A app.workflows.worker:queue worker --hostname=%i@%H --queues=%i --pool=prefork --concurrency=1 --loglevel=WARNING
Restart=on-failure
RestartSec=5
TimeoutStopSec=1100
KillMode=mixed
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/logistics-agent

[Install]
WantedBy=multi-user.target
